# MongoDB Connection String (must be a replica set for transactions if required, but standard standalone works too)
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/geotransit?retryWrites=true&w=majority"

# JWT Session Secret
SESSION_SECRET="generate-a-secure-random-32-character-secret-here"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Initial SMTP Settings (Fallback if not configured in DB)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@geotransit.com"
SMTP_FROM_NAME="GEO TRANSIT"
